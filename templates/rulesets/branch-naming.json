{
  "name": "branch-naming",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "~DEFAULT_BRANCH",
        "refs/heads/hotfix/**",
        "refs/heads/release/**",
        "refs/heads/patch/**",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "branch naming convention",
        "negate": false,
        "operator": "regex",
        "pattern": "^(feature|bugfix|chore)/(([A-Z][A-Z0-9]+-[0-9]+)|NOJIRA)(-[a-z0-9]+)*$"
      }
    }
  ]
}
